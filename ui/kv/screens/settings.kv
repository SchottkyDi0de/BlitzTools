#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<SettingsSection@MDLabel>:
    font_size: sp(9)
    theme_font_name: "Custom"
    font_name: app.get_font("robotomono")
    theme_text_color: "Custom"
    text_color: app.palette['accent']
    md_bg_color: 0, 0, 0, 0
    adaptive_height: True
    size_hint_y: None
    height: self.texture_size[1]
    padding: 0, dp(10), 0, dp(4)

<SettingsOptionButton>:
    option_value: ""
    option_label: ""
    active: False
    size_hint_y: None
    height: dp(38)
    padding: dp(10), dp(6)
    radius: dp(6)
    theme_bg_color: "Custom"
    theme_line_color: "Custom"
    md_bg_color: app.palette['surface']
    line_color: app.palette['accent_dim']
    line_width: dp(1)

    MDLabel:
        text: root.option_label
        font_size: sp(10)
        theme_font_size: "Custom"
        bold: root.active
        theme_font_name: "Custom"
        font_name: app.get_font(app.config.app_global.font.name)
        theme_text_color: "Custom"
        md_bg_color: 0, 0, 0, 0
        halign: "center"
        valign: "middle"

<SettingsScreen>:
    md_bg_color: app.palette['bg']

    ScrollView:
        do_scroll_x: False
        bar_width: dp(4)

        MDBoxLayout:
            orientation: "vertical"
            padding: dp(14), dp(12)
            spacing: dp(8)
            adaptive_height: True
            size_hint_y: None
            height: self.minimum_height

            MDLabel:
                text: app.locales.data['ru'].main.settings.title
                font_size: sp(14)
                bold: True
                theme_font_name: "Custom"
                font_name: app.get_font("robotomono")
                theme_text_color: "Custom"
                text_color: app.palette['accent']
                md_bg_color: 0, 0, 0, 0
                adaptive_height: True
                size_hint_y: None
                height: self.texture_size[1]
                padding: 0, 0, 0, dp(6)

            SettingsSection:
                text: app.locales.data['ru'].main.settings.sections.font

            MDBoxLayout:
                id: font_group
                orientation: "horizontal"
                spacing: dp(6)
                size_hint_y: None
                height: dp(38)

                SettingsOptionButton:
                    option_value: "roboto"
                    option_label: app.locales.data['ru'].main.settings.fonts.roboto
                    on_release: root.select_font("roboto")

                SettingsOptionButton:
                    option_value: "robotomono"
                    option_label: app.locales.data['ru'].main.settings.fonts.robotomono
                    on_release: root.select_font("robotomono")

                SettingsOptionButton:
                    option_value: "jost"
                    option_label: app.locales.data['ru'].main.settings.fonts.jost
                    on_release: root.select_font("jost")

            SettingsSection:
                text: app.locales.data['ru'].main.settings.sections.language

            MDBoxLayout:
                id: lang_group
                orientation: "horizontal"
                spacing: dp(6)
                size_hint_y: None
                height: dp(38)

                SettingsOptionButton:
                    option_value: "ru"
                    option_label: app.locales.data['ru'].main.settings.languages.ru
                    on_release: root.select_language("ru")

                SettingsOptionButton:
                    option_value: "en"
                    option_label: app.locales.data['ru'].main.settings.languages.en
                    on_release: root.select_language("en")
