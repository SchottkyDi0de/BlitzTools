#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

# Column width shares (avatar column is fixed dp(21) outside this sum).
#:set REPLAY_COL_PLAYER 0.24
#:set REPLAY_COL_TANK 0.34
#:set REPLAY_COL_DAMAGE 0.12
#:set REPLAY_COL_KILLS 0.08
#:set REPLAY_COL_XP 0.10
#:set REPLAY_COL_CREDITS 0.12

<ReplayAvatar>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0

<ReplayPlayerRow>:
    orientation: "horizontal"
    spacing: dp(6)
    padding: dp(4), dp(3)
    size_hint_y: None
    height: dp(25)
    radius: dp(3)
    md_bg_color: app.palette['bg_panel']

    ReplayAvatar:
        id: avatar
        avatar_url: root.avatar_url
        frame_kind: root.frame_kind

    MDLabel:
        text: (root.clan_tag + " " if root.clan_tag else "") + root.nickname
        shorten: True
        shorten_from: "right"
        font_size: sp(9)
        theme_font_size: "Custom"
        theme_font_name: "Custom"
        font_name: app.get_font(app.config.app_global.font.name)
        theme_text_color: "Custom"
        text_color: app.palette['text']
        md_bg_color: 0, 0, 0, 0
        size_hint_x: REPLAY_COL_PLAYER
        valign: "middle"

    ReplayTankCell:
        id: tank_cell
        tank_label: root.tank_label
        marks_count: root.marks_count

    MDLabel:
        text: root.damage_text
        halign: "right"
        font_size: sp(9)
        theme_font_size: "Custom"
        theme_font_name: "Custom"
        font_name: app.get_font("robotomono")
        theme_text_color: "Custom"
        text_color: app.palette['accent']
        md_bg_color: 0, 0, 0, 0
        size_hint_x: REPLAY_COL_DAMAGE
        valign: "middle"

    MDLabel:
        text: root.kills_text
        halign: "right"
        font_size: sp(9)
        theme_font_size: "Custom"
        theme_font_name: "Custom"
        font_name: app.get_font("robotomono")
        theme_text_color: "Custom"
        text_color: app.palette['text']
        md_bg_color: 0, 0, 0, 0
        size_hint_x: REPLAY_COL_KILLS
        valign: "middle"

    MDLabel:
        text: root.xp_text
        halign: "right"
        font_size: sp(8)
        theme_font_size: "Custom"
        theme_font_name: "Custom"
        font_name: app.get_font("robotomono")
        theme_text_color: "Custom"
        text_color: app.palette['muted']
        md_bg_color: 0, 0, 0, 0
        size_hint_x: REPLAY_COL_XP
        valign: "middle"

    MDLabel:
        text: root.credits_text
        halign: "right"
        font_size: sp(8)
        theme_font_size: "Custom"
        theme_font_name: "Custom"
        font_name: app.get_font("robotomono")
        theme_text_color: "Custom"
        text_color: app.palette['muted']
        md_bg_color: 0, 0, 0, 0
        size_hint_x: REPLAY_COL_CREDITS
        valign: "middle"

<ReplayTankCell>:
    orientation: "horizontal"
    spacing: 0
    size_hint_x: REPLAY_COL_TANK
    md_bg_color: 0, 0, 0, 0

    MDBoxLayout:
        id:         tank_group
        orientation: "horizontal"
        spacing: dp(4)
        size_hint_x: None
        size_hint_y: 1
        md_bg_color: 0, 0, 0, 0

        MDLabel:
            id: tank_name
            text: root.tank_label
            shorten: False
            font_size: sp(8)
            theme_font_size: "Custom"
            theme_font_name: "Custom"
            font_name: app.get_font(app.config.app_global.font.name)
            theme_text_color: "Custom"
            text_color: app.palette['text']
            md_bg_color: 0, 0, 0, 0
            size_hint_x: None
            size_hint_y: 1
            valign: "middle"

        TankMarksIndicator:
            id: tank_marks
            marks_count: root.marks_count
            size_hint_x: None
            size_hint_y: 1
            opacity: 1 if root.marks_count else 0

    Widget:
        size_hint_x: 1
        md_bg_color: 0, 0, 0, 0

<ReplayTeamPanel>:
    orientation: "vertical"
    spacing: dp(6)
    md_bg_color: 0, 0, 0, 0
    size_hint_x: 1
    size_hint_y: None
    height: self.minimum_height

    MDBoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: dp(18)
        spacing: dp(8)
        md_bg_color: 0, 0, 0, 0

        MDLabel:
            text: root.team_title
            font_size: sp(9)
            bold: True
            theme_font_size: "Custom"
            theme_font_name: "Custom"
            font_name: app.get_font("robotomono")
            theme_text_color: "Custom"
            text_color: app.palette['accent']
            md_bg_color: 0, 0, 0, 0
            size_hint_x: 1
            text_size: self.width, None
            shorten: True
            shorten_from: "right"

        MDLabel:
            text: root.team_badge
            font_size: sp(8)
            bold: True
            theme_font_size: "Custom"
            theme_font_name: "Custom"
            font_name: app.get_font("robotomono")
            theme_text_color: "Custom"
            text_color: root.badge_color
            md_bg_color: 0, 0, 0, 0
            size_hint_x: None
            size_hint_y: None
            width: dp(84)
            height: dp(18)
            halign: "right"
            valign: "middle"
            text_size: self.width, self.height
            shorten: False

    MDBoxLayout:
        id: table_box
        orientation: "vertical"
        spacing: dp(1)
        padding: dp(1)
        size_hint_y: None
        height: self.minimum_height
        md_bg_color: app.palette['accent_dim']

        MDBoxLayout:
            id: table_header
            orientation: "horizontal"
            size_hint_y: None
            height: dp(16)
            spacing: dp(6)
            padding: dp(4), dp(2)
            md_bg_color: app.palette['surface']

            Widget:
                size_hint_x: None
                width: dp(21)

            MDLabel:
                id: col_player
                text: ""
                font_size: sp(8)
                bold: True
                theme_font_name: "Custom"
                font_name: app.get_font("robotomono")
                theme_text_color: "Custom"
                text_color: app.palette['muted']
                md_bg_color: 0, 0, 0, 0
                size_hint_x: REPLAY_COL_PLAYER

            MDLabel:
                id: col_tank
                text: ""
                font_size: sp(8)
                bold: True
                halign: "left"
                theme_font_name: "Custom"
                font_name: app.get_font("robotomono")
                theme_text_color: "Custom"
                text_color: app.palette['muted']
                md_bg_color: 0, 0, 0, 0
                size_hint_x: REPLAY_COL_TANK

            MDLabel:
                id: col_damage
                text: ""
                font_size: sp(8)
                bold: True
                halign: "right"
                theme_font_name: "Custom"
                font_name: app.get_font("robotomono")
                theme_text_color: "Custom"
                text_color: app.palette['muted']
                md_bg_color: 0, 0, 0, 0
                size_hint_x: REPLAY_COL_DAMAGE

            MDLabel:
                id: col_kills
                text: ""
                font_size: sp(8)
                bold: True
                halign: "right"
                theme_font_name: "Custom"
                font_name: app.get_font("robotomono")
                theme_text_color: "Custom"
                text_color: app.palette['muted']
                md_bg_color: 0, 0, 0, 0
                size_hint_x: REPLAY_COL_KILLS

            MDLabel:
                id: col_xp
                text: ""
                font_size: sp(8)
                bold: True
                halign: "right"
                theme_font_name: "Custom"
                font_name: app.get_font("robotomono")
                theme_text_color: "Custom"
                text_color: app.palette['muted']
                md_bg_color: 0, 0, 0, 0
                size_hint_x: REPLAY_COL_XP

            MDLabel:
                id: col_credits
                text: ""
                font_size: sp(8)
                bold: True
                halign: "right"
                theme_font_name: "Custom"
                font_name: app.get_font("robotomono")
                theme_text_color: "Custom"
                text_color: app.palette['muted']
                md_bg_color: 0, 0, 0, 0
                size_hint_x: REPLAY_COL_CREDITS

        MDBoxLayout:
            id: rows_box
            orientation: "vertical"
            spacing: dp(1)
            adaptive_height: True
            size_hint_y: None
            height: self.minimum_height
            md_bg_color: app.palette['bg']

<ReplayScreen>:
    md_bg_color: app.palette['bg']

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(14), dp(12)
        spacing: dp(8)
        md_bg_color: app.palette['bg']

        MDLabel:
            id: screen_title
            text: "REPLAYS"
            font_size: sp(14)
            bold: True
            theme_font_name: "Custom"
            font_name: app.get_font("robotomono")
            theme_text_color: "Custom"
            text_color: app.palette['accent']
            md_bg_color: 0, 0, 0, 0
            size_hint_y: None
            height: self.texture_size[1]

        DvpActionButton:
            id: pick_replay_btn
            action_label: "Pick replay"
            size_hint_y: None
            on_release: root.pick_replay()

        ScrollView:
            id: content_scroll
            size_hint_y: 1
            do_scroll_x: False
            bar_width: dp(4)
            scroll_type: ["bars", "content"]

            MDBoxLayout:
                id: content_box
                orientation: "vertical"
                spacing: dp(10)
                adaptive_height: True
                size_hint_y: None
                height: self.minimum_height
                md_bg_color: 0, 0, 0, 0

                MDLabel:
                    id: status_label
                    text: "Select a replay file."
                    font_size: sp(9)
                    theme_font_name: "Custom"
                    font_name: app.get_font(app.config.app_global.font.name)
                    theme_text_color: "Custom"
                    text_color: app.palette['muted']
                    md_bg_color: 0, 0, 0, 0
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None

                MDBoxLayout:
                    id: summary_box
                    orientation: "vertical"
                    spacing: dp(6)
                    size_hint_y: None
                    adaptive_height: True
                    opacity: 0
                    disabled: True
                    height: 0
                    padding: 0
                    md_bg_color: 0, 0, 0, 0

                    TopAlignedHBox:
                        id: summary_header_row
                        spacing: dp(20)
                        size_hint_y: None
                        adaptive_height: True
                        padding: 0
                        md_bg_color: 0, 0, 0, 0

                        MDBoxLayout:
                            id: author_stats_box
                            orientation: "vertical"
                            spacing: dp(4)
                            size_hint_x: 0.5
                            size_hint_y: None
                            adaptive_height: True
                            padding: 0
                            md_bg_color: 0, 0, 0, 0

                            MDLabel:
                                id: author_stats_title
                                text: "Author stats"
                                font_size: sp(9)
                                bold: True
                                theme_font_name: "Custom"
                                font_name: app.get_font("robotomono")
                                theme_text_color: "Custom"
                                text_color: app.palette['accent']
                                md_bg_color: 0, 0, 0, 0
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None
                                halign: "left"

                            MDLabel:
                                id: author_battle_line
                                text: ""
                                font_size: sp(8)
                                theme_font_name: "Custom"
                                font_name: app.get_font("robotomono")
                                theme_text_color: "Custom"
                                text_color: app.palette['muted']
                                md_bg_color: 0, 0, 0, 0
                                size_hint_y: None
                                adaptive_height: True
                                text_size: self.width, None

                            MDLabel:
                                id: author_stats_header
                                font_size: sp(8)
                                theme_line_height: "Custom"
                                line_height: 1.35
                                theme_font_name: "Custom"
                                font_name: app.get_font("robotomono")
                                theme_text_color: "Custom"
                                text_color: app.palette['muted']
                                md_bg_color: 0, 0, 0, 0
                                size_hint_y: None
                                adaptive_height: True
                                text_size: self.width, None

                            MDBoxLayout:
                                id: author_tank_row
                                orientation: "horizontal"
                                spacing: dp(4)
                                size_hint_x: 1
                                size_hint_y: None
                                adaptive_height: True
                                padding: 0
                                md_bg_color: 0, 0, 0, 0

                                MDLabel:
                                    id: author_tank_line
                                    text: ""
                                    font_size: sp(8)
                                    theme_font_name: "Custom"
                                    font_name: app.get_font("robotomono")
                                    theme_text_color: "Custom"
                                    text_color: app.palette['muted']
                                    md_bg_color: 0, 0, 0, 0
                                    size_hint_x: None
                                    size_hint_y: None
                                    adaptive_height: True
                                    text_size: self.width, None
                                    valign: "middle"

                                TankMarksIndicator:
                                    id: author_marks
                                    marks_count: 0
                                    size_hint_x: None
                                    size_hint_y: 1
                                    opacity: 1 if self.marks_count else 0

                            MDLabel:
                                id: author_stats_label
                                font_size: sp(8)
                                theme_line_height: "Custom"
                                line_height: 1.35
                                theme_font_name: "Custom"
                                font_name: app.get_font("robotomono")
                                theme_text_color: "Custom"
                                text_color: app.palette['muted']
                                md_bg_color: 0, 0, 0, 0
                                size_hint_y: None
                                adaptive_height: True
                                text_size: self.width, None

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(6)
                            size_hint_x: 0.5
                            size_hint_y: None
                            adaptive_height: True
                            padding: 0
                            md_bg_color: 0, 0, 0, 0

                            MDLabel:
                                id: winner_label
                                font_size: sp(10)
                                bold: True
                                theme_font_name: "Custom"
                                font_name: app.get_font("robotomono")
                                theme_text_color: "Custom"
                                text_color: app.palette['accent']
                                md_bg_color: 0, 0, 0, 0
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None
                                theme_line_height: "Custom"
                                line_height: 1
                                halign: "left"
                                valign: "top"

                            MDLabel:
                                id: meta_label
                                font_size: sp(8)
                                theme_line_height: "Custom"
                                line_height: 1.35
                                theme_font_name: "Custom"
                                font_name: app.get_font("robotomono")
                                theme_text_color: "Custom"
                                text_color: app.palette['muted']
                                md_bg_color: 0, 0, 0, 0
                                size_hint_y: None
                                adaptive_height: True
                                text_size: self.width, None

                MDBoxLayout:
                    id: teams_box
                    orientation: "vertical"
                    spacing: dp(16)
                    size_hint_y: None
                    adaptive_height: True
                    opacity: 0
                    disabled: True
                    height: 0
                    md_bg_color: 0, 0, 0, 0

                    ReplayTeamPanel:
                        id: team1_panel

                    ReplayTeamPanel:
                        id: team2_panel
